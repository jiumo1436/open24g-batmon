{
  "_说明": "语法示例（HID 多字节电量 + 握手帧 + 求和校验）。VID / PID / 帧头 / 数值全部为虚构，不对应任何真实产品或私人抓包。",
  "format": "dianliang-device-pack",
  "version": 1,
  "note": "示例：先发握手帧唤醒，再发查询帧；电量是两字节小端、0.1% 精度；发送帧求和校验写在最后一位。",
  "devices": [
    {
      "key": "example-keyboard-k87",
      "name": "示例键盘 K87",
      "type": "keyboard",
      "wire": "2.4G",
      "protocol": "示例协议 V2",

      "transport": {
        "type": "hid"
      },

      "match": {
        "vid": "0x1234",
        "pid": "0x1002",
        "usage_page": "0xFF01",
        "min_in": 20,
        "min_out": 20
      },

      "read": {
        "_说明": "不少接收器要先握手才肯回报电量；pre 发完等 pre_delay_ms 再发 query。",
        "pre": [
          "A5 5A 02 F0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
        ],
        "pre_delay_ms": 50,
        "passive_ms": 200,
        "query": [
          "A5 5A 02 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
        ],
        "checksum": {
          "_说明": "第 0~18 字节求和取低 8 位，写到第 19 位",
          "mode": "sum_tail",
          "from": 0,
          "to": 19,
          "at": 19
        },
        "pad_to": 20,
        "attempts": 2,
        "listen_ms": 800,

        "reply": {
          "contains": ["A5 5A"],
          "battery": {
            "_说明": "两字节小端原始值 × 0.1 = 百分比（例如 0x02 0x8A → 650 → 65.0%）",
            "byte": 5,
            "bytes": 2,
            "order": "little",
            "scale": 0.1
          },
          "charging": {
            "_说明": "充电位在状态字节的最高位",
            "byte": 7,
            "mask": "0x80"
          },
          "range": [0, 100]
        }
      }
    }
  ]
}
