        "query": ["01 03 00 00 00 01"],
        "checksum": {
          "mode": "sum_tail",
          "from": 0,
          "to": 5,
          "at": 5
        },
        "pad_to": 0,
        "attempts": 2,
        "listen_ms": 600,
        "reply": {
          "contains": ["01 03"],
          "checksum": { "mode": "none" },
          "battery": { "byte": 3 },
          "range": [1, 100]
        }
      }
    }
  ]
